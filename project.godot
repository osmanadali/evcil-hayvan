; Engine configuration file.
config_version=5

[application]

config/name="Patili Gezinti"
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.965, 0.906, 0.784, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
textures/default_filters/anisotropic_filtering_level=2

[shader_globals]

weather_wet={
"type": "float",
"value": 0.0
}
weather_snow={
"type": "float",
"value": 0.0
}
weather_rain={
"type": "float",
"value": 0.0
}
